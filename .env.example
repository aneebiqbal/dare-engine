# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database -------------------------------------------------------------
POSTGRES_USER=clipdesk
POSTGRES_PASSWORD=clipdesk
POSTGRES_DB=clipdesk
DATABASE_URL=postgresql://clipdesk:clipdesk@db:5432/clipdesk

# --- S3-compatible storage (MinIO in dev) ---------------------------------
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=clipdesk
S3_ACCESS_KEY=clipdesk
S3_SECRET_KEY=clipdesk-dev-secret
S3_REGION=us-east-1

# --- LLM (M2+) ------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Recorded response file used by CI instead of a live call.
LLM_RECORDED_RESPONSE=

# --- Relay (M4+) ----------------------------------------------------------
RELAY_HOOK_SECRET=

# --- Google OAuth / YouTube (M5+, M8) -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
YOUTUBE_API_KEY=
# 32-byte key used to encrypt OAuth refresh tokens at rest (base64 or hex).
TOKEN_ENCRYPTION_KEY=
