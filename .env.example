# Copy to .env and fill in. .env is gitignored and must never be committed.
# No values below are real. See docs/SETUP_KEYS.md for how to create each one.

# --- Database -------------------------------------------------------------
# Pooled connection for the API (Neon: host contains -pooler).
DATABASE_URL=
# Direct connection for migrations and the job worker (Neon: no -pooler).
DATABASE_URL_DIRECT=
POSTGRES_USER=clipdesk
POSTGRES_PASSWORD=
POSTGRES_DB=clipdesk

# --- Sessions -------------------------------------------------------------
# Generate locally: openssl rand -hex 32
SESSION_SECRET=
# production | development. Production sets Secure cookies.
APP_ENV=development
# Force Secure cookies even in development (true | false).
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3100

# --- Rate limiting --------------------------------------------------------
# Per-IP requests per window; /auth and /admin get the smaller budget.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH=10

# --- Sign-up --------------------------------------------------------------
# true = admins create invite codes; false = open sign-up.
INVITE_REQUIRED=true

# --- Development sign-in (tests only, never production) -------------------
DEV_AUTH_ENABLED=false

# --- Storage --------------------------------------------------------------
# local | s3. local writes under STORAGE_LOCAL_DIR; s3 uses the S3_* values.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- AI -------------------------------------------------------------------
# openai | recorded | stub. openai speaks the OpenAI-compatible chat format.
LLM_PROVIDER=openai
# OpenCode Zen: https://opencode.ai/zen/v1   xAI Grok: https://api.x.ai/v1
# Local open-weight models on this Mac (Apple Silicon, Metal): Ollama serves
# the same OpenAI chat format, so no code changes are needed. Chinese open
# weights (Qwen / Kimi / DeepSeek) run fully offline.
#   make setup-engine
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3:8b     # or qwen2.5:7b, deepseek-r1:7b, kimi-k2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Recorded responses for CI (LLM_PROVIDER=recorded).
LLM_RECORDED_RESPONSE=/app/app/llm_recorded.json
LLM_TIMEOUT=60
# Legacy: the worker beat selector reads GEMINI_API_KEY directly. The new
# OpenAI-compatible path above is the supported one.
GEMINI_API_KEY=

# --- Research brain -------------------------------------------------------
# The daily research worker pulls public sources per game and writes sourced
# ideas. Every key is optional: with none set it runs on the recorded sample
# feed and flags the output as a fallback.
# RAWG games database (https://rawg.io/apidocs) — one key, no OAuth.
RAWG_API_KEY=
# YouTube Data API v3 (https://developers.google.com/youtube/v3) — what is
# being searched/viewed for the game now.
YOUTUBE_API_KEY=
# Reddit read-only app (https://www.reddit.com/prefs/apps). Optional: without
# it the worker reads the public subreddit JSON with a User-Agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=clipdesk-research/0.1
# Daily run, server local hour, and whether the scheduler is on.
RESEARCH_ENABLED=true
RESEARCH_HOUR=5
RESEARCH_TIMEZONE=UTC

# --- OBS live view --------------------------------------------------------
# OBS 31+ ships obs-websocket 5.x. Enable it in OBS → Tools → WebSocket Server
# Settings and copy the password here. In a container the host is
# host.docker.internal; on the host itself use ws://localhost:4455.
OBS_WS_URL=ws://host.docker.internal:4455
OBS_WS_PASSWORD=
OBS_SNAPSHOT_WIDTH=640

# --- SSD import -----------------------------------------------------------
# The API container cannot see /Volumes. A host bridge lists the drive and
# copies the chosen file into a shared inbox; the API imports it locally.
#   make ssd-bridge
SSD_BRIDGE_URL=http://host.docker.internal:8799
SSD_INBOX_DIR=/ssd-inbox
SSD_MOUNT_DIR=/Volumes

# --- Local MLX transcription ----------------------------------------------
# The worker container cannot use Metal, so transcription runs on the host via
# the MLX bridge. Start it with `make mlx-bridge`. Empty = faster-whisper CPU
# inside the container (slower, but no host setup).
MLX_WHISPER_URL=http://host.docker.internal:8798
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# Host bridge that owns MLX transcription and the Ollama model manager.
MODEL_BRIDGE_URL=http://host.docker.internal:8798

# --- Voice-over -----------------------------------------------------------
# Piper is MIT. Download a voice with: make voice
TTS_COMMAND=piper
TTS_VOICE=en_US-amy-medium
TTS_MODEL_DIR=/data/voices

# --- Transcription --------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_STALE_SECONDS=600

# --- Uploads --------------------------------------------------------------
UPLOAD_TMP_DIR=/tmp/clipdesk-uploads

# --- Relay ----------------------------------------------------------------
# Optional shared secret for the relay segment hook.
RELAY_HOOK_SECRET=

# --- Web ------------------------------------------------------------------
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=0
NEXT_PUBLIC_DEV_AUTH=0
